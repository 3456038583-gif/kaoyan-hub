# 原卷 PDF 与 KaTeX 体积大且几乎不变，交给浏览器长期缓存
# 模拟卷单套 PDF（/pdfs/mock/）文件名不带哈希，重切后要能拿到新版，所以放宽到 7 天
/pdfs/mock/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/pdfs/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 题目配图与站点图标
/figs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/exam/figs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/exam/pdf/*
  Cache-Control: public, max-age=2592000

# 数学 / 英语 / 政治题库数据（含 1.9MB 的 mockdata.js）：缓存 1 天 + 后台静默更新 7 天
/mockdata.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/meta*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/keymap.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/supp.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/exam/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/politics/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 公共脚本与样式：缓存 1 小时 + 24 小时后台静默更新（重要变更通过 ?v= 立即生效）
/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/exam/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/exam/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/politics/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/politics/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/vocab/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/vocab/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/export/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/export/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# 知识库索引随每次构建变化，短缓存 + SWR
/library/nav.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/library/search.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# 单词发音：文件名由单词派生、内容不会变，长期缓存
/vocab/audio/*
  Cache-Control: public, max-age=31536000, immutable

# 词库分片：文件名固定，靠 ?v= 版本号更新
/vocab/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
