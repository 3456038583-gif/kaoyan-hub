{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker 名沿用历史值：改名会新建一个 Worker，导致下面两个自定义域名冲突。
  // 项目对外名称见 GitHub 仓库 kaoyan-hub，与目录名一致。
  "name": "kaoyan-math-site-full",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaoyan-cloud",
      "database_id": "7b9c051d-b640-40db-bf1b-655fcb0a4749"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "kaoyan.feikntn111.com",
      "custom_domain": true
    },
    {
      "pattern": "k.feikntn111.com",
      "custom_domain": true
    },
    {
      "pattern": "kaoyan.feikntn111.us.ci",
      "custom_domain": true
    },
    {
      "pattern": "k.feikntn111.us.ci",
      "custom_domain": true
    }
  ]
}
